{
  "name": "whale-lens-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && tsx --test app/components/*.test.ts app/lib/*.test.ts app/lib/realtime/*.test.ts services/copy-runner/*.test.ts",
    "copy-runner": "tsx services/copy-runner/index.ts",
    "test:copy-runner": "tsx --test services/copy-runner/*.test.ts",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-Local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Stop-Local.ps1",
    "local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Get-LocalStatus.ps1",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "data:prefetch": "tsx scripts/prefetch-wallets.ts",
    "data:compact": "tsx scripts/compact-preloaded-wallets.ts",
    "backtest:equity": "tsx scripts/backtest-equity-sizing.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lightweight-charts": "^5.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
