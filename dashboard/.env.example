# Local standalone bridge. `npm run local:start` supplies these process-only,
# so copying them to a real .env file is optional.
COPY_RUNNER_BASE_URL=http://127.0.0.1:8788
COPY_RUNNER_CONTROL_TOKEN=
# Omit COPY_RUNNER_WHALES to use the runner's screened SEED_WALLETS TOP 10.
# COPY_RUNNER_WHALES=[{"address":"0x...","copyRatio":0.01}]

# Standalone collector (TOP 10 screened wallets and common symbols are defaults)
COPY_RUNNER_MODE=SIMULATION
COPY_RUNNER_HOST=127.0.0.1
COPY_RUNNER_PORT=8788
COPY_RUNNER_DATABASE=./data/copy-runner.sqlite
# Optional fixed paper/live observation window. Set both or neither.
# COPY_RUNNER_SESSION_STARTED_AT_MS=1786752000000
# COPY_RUNNER_SESSION_ENDS_AT_MS=1787011200000
COPY_RUNNER_AUTOSTART=true
COPY_RUNNER_REQUIRE_FLAT_START=true
COPY_RUNNER_FOLLOWER_CAPITAL_USD=1000
COPY_RUNNER_MAX_ACCOUNT_STATE_AGE_MS=60000
COPY_RUNNER_MIN_SOURCE_ACCOUNT_VALUE_USD=10000
COPY_RUNNER_MAX_NOTIONAL_USD=1000000000
COPY_RUNNER_MAX_SLIPPAGE_BPS=30
COPY_RUNNER_MAX_DAILY_LOSS_USD=50

# Same-venue execution stays disabled unless every value is configured server-side.
# Install the official signer into dashboard/.venv first:
#   python -m venv .venv
#   .venv\Scripts\python -m pip install -r services/copy-runner/requirements.txt
HYPERLIQUID_ENABLED=false
HYPERLIQUID_TESTNET=true
HYPERLIQUID_AGENT_PRIVATE_KEY=
HYPERLIQUID_MASTER_ACCOUNT_ADDRESS=
# Each source must map to a distinct target subaccount/account.
# HYPERLIQUID_TARGETS_JSON={"0xsource":{"accountAddress":"0xtarget","vaultAddress":"0xtarget"}}
HYPERLIQUID_TARGETS_JSON=
HYPERLIQUID_CATCHUP_SLIPPAGE=0.05
HYPERLIQUID_PRODUCTION_CONFIRMED=
