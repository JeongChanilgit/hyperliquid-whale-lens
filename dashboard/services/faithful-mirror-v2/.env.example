FMV2_CONFIG=config/five-whale-faithful-mirror.json
FMV2_CONTROL_TOKEN=replace-with-at-least-16-random-characters

# LIVE only. One approved API wallet per configured pair, in pair order.
FMV2_MASTER_ACCOUNT_ADDRESS=0x...
FMV2_AGENT_PRIVATE_KEY_1=0x...
FMV2_AGENT_PRIVATE_KEY_2=0x...
FMV2_AGENT_PRIVATE_KEY_3=0x...
FMV2_AGENT_PRIVATE_KEY_4=0x...
FMV2_AGENT_PRIVATE_KEY_5=0x...
FMV2_PYTHON=.venv/Scripts/python.exe
FMV2_ACTION_EXPIRES_AFTER_MS=5000
FMV2_TESTNET=true

# Mainnet only.
FMV2_PRODUCTION_CONFIRMED=I_UNDERSTAND_LIVE_HYPERLIQUID_ORDERS
