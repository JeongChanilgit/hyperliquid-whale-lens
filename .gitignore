# Secrets and machine-local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.kdbx

# JavaScript/Python dependencies and build output
node_modules/
.pnp/
.yarn/
.next/
.vinext/
.wrangler/
.venv/
__pycache__/
*.pyc
coverage/
dist/
/build/
/dashboard/build/*
!/dashboard/build/sites-vite-plugin.ts
out/
outputs/
*.tsbuildinfo

# Runtime state: never commit a running SQLite database or audit log
data/
logs/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal
*.log
*.pid

# Screening runtime: publish audited run reports (including explicit PARTIAL
# diagnostics) and only hash-linked VERIFIED canonical state. Raw caches,
# checkpoints, discovery-cycle state, pilots, and legacy ranking reports stay local.
/reports/**
!/reports/perp-twr-discovery/
!/reports/perp-twr-discovery/latest.json
!/reports/perp-twr-discovery/latest.md
!/reports/perp-twr-discovery/run-perp-twr-*.json
!/reports/perp-twr-discovery/run-perp-twr-*.md
!/reports/perp-twr-candidates/
!/reports/perp-twr-candidates/latest-top2000.json
!/reports/perp-twr-candidates/run-perp-twr-*-top2000.json
!/reports/perp-twr-research/
!/reports/perp-twr-research/latest.json
!/reports/perp-twr-research/latest-candidates.json
!/reports/perp-twr-activity-90d/
!/reports/perp-twr-activity-90d/latest.json
!/reports/perp-twr-activity-90d/latest.md
!/reports/perp-twr-activity-90d/run-*.json
!/reports/perp-twr-activity-90d/run-*.md
!/reports/perp-twr-rescue/
!/reports/perp-twr-rescue/latest.md
!/reports/perp-twr-rescue/latest-summary.json
!/reports/perp-twr-trade-qualified/
!/reports/perp-twr-trade-qualified/latest.json
!/reports/perp-twr-trade-qualified/run-*.json
!/reports/perp-month-simple-twr/
!/reports/perp-month-simple-twr/latest.json
!/reports/perp-month-simple-twr/latest.md
!/reports/perp-month-simple-twr/perp-month-simple-twr-*.json
!/reports/perp-month-simple-twr/perp-month-simple-twr-*.md
!/reports/perp-month-simple-twr/top10-dossier-data.json
!/reports/perp-month-simple-twr/top10-dossier.html
/state/**
!/state/perp-twr-top10/
!/state/perp-twr-top10/latest_active_top10.json
!/state/perp-twr-research/
!/state/perp-twr-research/latest_active_top10.json
!/state/perp-twr-trade-qualified/
!/state/perp-twr-trade-qualified/latest_active_top10.json
!/state/perp-month-simple-twr/
!/state/perp-month-simple-twr/latest.json
!/state/perp-month-simple-twr/latest.md

